{
  "manifest_version": 3,
  "name": "MYRA Mirror",
  "version": "0.4.0",
  "description": "Every brand site, in your order. MYRA lifts the pieces you'd want to the top — the site stays the brand's own.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MYRA Mirror",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/mirror/connect*",
        "https://www.myraassistant.co.uk/mirror/connect*",
        "https://myraassistant.co.uk/mirror/connect*"
      ],
      "js": [
        "browser-api.js",
        "connect.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "http://localhost:3000/*",
        "https://www.myraassistant.co.uk/*",
        "https://myraassistant.co.uk/*"
      ],
      "js": [
        "browser-api.js",
        "adapters.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*"
      ],
      "js": [
        "browser-api.js",
        "vinted.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/mirror.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
