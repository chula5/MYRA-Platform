NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
ADMIN_USER_ID=your_supabase_user_id_for_admin_access

# ── Wardrobe Import (admin → Wardrobe, client → /me/wardrobe) ────────────────
# Detect + cutout run on OpenAI; scoring reuses ANTHROPIC_API_KEY (same vision
# pass as retail items). Models are env-configurable; defaults are current.
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-5.6-terra
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium   # low | medium | high — medium is the default
# Optional: lets cutouts land in the wardrobe/<owner> Cloudinary folder and be
# deleted when a client deletes a photo. Without these the library's existing
# uploader is used (no deletion).
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── MYRA Mirror browser extension (YOU page → "MYRA in Safari and Chrome") ────
# Where "Add to Chrome" sends her: the Chrome Web Store listing, once published.
# NEXT_PUBLIC_MIRROR_STORE_URL=
# Where "Add to Safari" sends her: the MYRA app on the App Store. On iPhone the
# Safari extension ships inside the app (see SETUP.md, "Safari extension").
# NEXT_PUBLIC_MIRROR_SAFARI_URL=
