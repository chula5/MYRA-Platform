# Required. Drafting and vision extraction both go through this.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only needed if you want to exercise the Instagram OAuth shell.
# See README — Instagram does NOT expose saved posts to third parties, so this
# connects your own Business/Creator account's media, nothing more.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3100/api/instagram/callback

# Optional. Canva Connect cannot create a design from text (see README).
# Left here for the day it can.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
