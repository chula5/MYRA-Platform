<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the Safari extension and the share sheet: the Mirror token
	     is written once, on connect, and read by both. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.uk.co.myraassistant.app</string>
	</array>
</dict>
</plist>
