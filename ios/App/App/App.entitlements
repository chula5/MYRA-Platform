<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app shares the container so the token written by the Safari
	     extension can be seen by the share sheet, and so the app can clear it
	     when she disconnects. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.uk.co.myraassistant.app</string>
	</array>
</dict>
</plist>
