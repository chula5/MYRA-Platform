<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The container the app, the Safari extension and the share sheet all
	     read. The Safari extension writes the Mirror token here when she
	     connects, so the share sheet never asks her to sign in again. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.uk.co.myraassistant.app</string>
	</array>
</dict>
</plist>
